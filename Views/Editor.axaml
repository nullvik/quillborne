<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:quillborne.ViewModels"
    x:Class="quillborne.Views.Editor"
    x:DataType="vm:EditorViewModel"
>

    <TextBox
        AcceptsReturn="true"
        TextWrapping="Wrap"
        AcceptsTab="true"
        BorderThickness="0"
        CaretBlinkInterval="0"
        FontFamily="{StaticResource SourceSerif}"
        FontSize="18"
        Padding="75"
        VerticalContentAlignment="Top"
        ScrollViewer.VerticalScrollBarVisibility="Hidden"
    />

</UserControl>
