<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:quillborne.ViewModels"
    x:Class="quillborne.Views.Editor"
    x:DataType="vm:EditorViewModel"
>

    <Grid ColumnDefinitions="1*,2*,1*" Background="#2B2B2B">
        <ScrollViewer
            Grid.Column="1"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollBarVisibility="Hidden"
            BringIntoViewOnFocusChange="False"
        >
            <Border
                Width="794"
                Height="1123"
                Background="#FAFAFA"
                HorizontalAlignment="Center"
                Margin="40"
            >
                <TextBox
                    AcceptsReturn="true"
                    TextWrapping="Wrap"
                    AcceptsTab="true"
                    BorderThickness="0"
                    CaretBlinkInterval="0"
                    FontFamily="{StaticResource SourceSerif}"
                    FontSize="18"
                    Padding="75"
                    VerticalContentAlignment="Top"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                />
            </Border>
        </ScrollViewer>
    </Grid>

</UserControl>
