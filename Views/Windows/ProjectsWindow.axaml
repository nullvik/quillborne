<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:quillborne.ViewModels.Windows"
    x:Class="quillborne.Views.Windows.ProjectsWindow"
    x:DataType="vm:ProjectsViewModel"
    d:DesignWidth="500"
    d:DesignHeight="360"
    Icon="/Assets/logo.ico"
    Title="Projects"
    Background="{DynamicResource BackgroundBrush}"
    Width="500"
    Height="360"
    CanResize="False"
    WindowStartupLocation="CenterScreen"
>

    <Grid RowDefinitions="Auto,*,Auto" Margin="36">

        <StackPanel
            Grid.Row="0"
            Spacing="6"
            HorizontalAlignment="Center"
            Margin="0,8,0,28"
        >

            <TextBlock
                Text="Welcome to Quillborne"
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimaryBrush}"
                HorizontalAlignment="Center"
            />

            <TextBlock
                Text="Create a new project or continue writing."
                FontSize="14"
                Foreground="{DynamicResource TextSecondaryBrush}"
                HorizontalAlignment="Center"
            />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">

            <Button
                Grid.Column="0"
                Command="{Binding NewProjectCommand}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
            >

                <Button.Styles>
                    <Style Selector="^:pointerover">
                        <Setter
                            Property="Background"
                            Value="{DynamicResource HighlightSoftBrush}"
                        />
                        <Setter
                            Property="BorderBrush"
                            Value="{DynamicResource HighlightBrush}"
                        />
                    </Style>
                </Button.Styles>

                <StackPanel
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                >

                    <Border
                        Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="{DynamicResource HighlightSoftBrush}"
                        HorizontalAlignment="Center"
                    >

                        <TextBlock
                            Text="+"
                            FontSize="30"
                            FontWeight="Light"
                            Foreground="{DynamicResource HighlightBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                        />
                    </Border>

                    <TextBlock
                        Text="New Project"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        HorizontalAlignment="Center"
                    />

                    <TextBlock
                        Text="Start a new writing project"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                    />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="1"
                Command="{Binding OpenProjectCommand}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
            >

                <Button.Styles>
                    <Style Selector="^:pointerover">
                        <Setter
                            Property="Background"
                            Value="{DynamicResource HighlightSoftBrush}"
                        />
                        <Setter
                            Property="BorderBrush"
                            Value="{DynamicResource HighlightBrush}"
                        />
                    </Style>
                </Button.Styles>

                <StackPanel
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                >

                    <Border
                        Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="{DynamicResource HighlightSoftBrush}"
                        HorizontalAlignment="Center"
                    >

                        <TextBlock
                            Text="↗"
                            FontSize="25"
                            Foreground="{DynamicResource HighlightBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                        />
                    </Border>

                    <TextBlock
                        Text="Open Project"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        HorizontalAlignment="Center"
                    />

                    <TextBlock
                        Text="Continue an existing project"
                        FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}"
                        HorizontalAlignment="Center"
                    />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock
            Grid.Row="2"
            Text="Your projects are stored locally."
            FontSize="11"
            Foreground="{DynamicResource TextMutedBrush}"
            HorizontalAlignment="Center"
            Margin="0,24,0,0"
        />
    </Grid>
</Window>
